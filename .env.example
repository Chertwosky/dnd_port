# Local file persist (default when not on Vercel)
# DND_DATA_DIR=C:\path\to\custom\persist

# Upstash Redis / Vercel KV (durable state on Vercel)
# Marketplace "Upstash for Redis" usually injects KV_REST_API_* automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional TTLs (seconds)
# DND_SESSION_TTL_SEC=1209600
# DND_LOBBY_TTL_SEC=1209600
