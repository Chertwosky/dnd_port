# Local file persist (default when not on Vercel)
# DND_DATA_DIR=C:\path\to\custom\persist

# Upstash Redis (required for durable state on Vercel)
# Create free DB: https://upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional TTLs (seconds)
# DND_SESSION_TTL_SEC=1209600
# DND_LOBBY_TTL_SEC=1209600
